# --- Python Internals ---
__pycache__/
*.py[cod]
*$py.class

# --- Build & Distribution ---
dist/
build/
*.egg-info/
.eggs/

# --- Virtual Environments ---
.venv/
venv/
env/

# --- Secrets & Config (CRITICAL) ---
.env

